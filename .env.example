VAS_BIND_HOST=127.0.0.1
VAS_BIND_PORT=8080
VAS_DATA_DIR=./data
# Native runs: set VAS_MASTER_KEY or point VAS_MASTER_KEY_FILE to a mode-0600 file.
VAS_MASTER_KEY_FILE=./secrets/master_key
# Required only when public URL/cookies use HTTPS
VAS_SECURE_COOKIES=false
# Optional path to the app-server executable bundled by your deployment
VAS_CODEX_COMMAND=codex app-server
