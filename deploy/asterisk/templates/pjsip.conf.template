[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

[voice-agent-registration]
type=registration
outbound_auth=voice-agent-auth
server_uri=sip:${PBX_HOST}:${PBX_PORT}
client_uri=sip:${SIP_EXTENSION}@${PBX_HOST}:${PBX_PORT}
transport=transport-udp
retry_interval=60
forbidden_retry_interval=300
expiration=3600

[voice-agent-auth]
type=auth
auth_type=userpass
username=${SIP_AUTH_USERNAME}
password=${SIP_PASSWORD}

[voice-agent-endpoint]
type=endpoint
context=voice-agent-inbound
disallow=all
allow=ulaw,alaw
outbound_auth=voice-agent-auth
aors=voice-agent-aor
transport=transport-udp
direct_media=no

[voice-agent-aor]
type=aor
contact=sip:${PBX_HOST}:${PBX_PORT}

[voice-agent-identify]
type=identify
endpoint=voice-agent-endpoint
match=${PBX_HOST}
